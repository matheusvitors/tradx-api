{
	"name": "tradx-api",
	"version": "1.0.0-Beta[24/01/2025]2",
	"main": "index.js",
	"type": "module",
	"scripts": {
		"start": "node dist/server.js",
		"build": "tsup src",
		"dev": "dotenv -e .env.development nodemon src/server.ts",
		"upgrade": "ncu -u && npm i",
		"test": "vitest",
		"test:coverage": "vitest --coverage  --reporter=html ",
		"test:unit": "vitest --dir src",
		"test:unit:watch": "vitest --ui --dir __tests__/unit",
		"test:file": "vitest --ui src/application/controllers/ativo/list-ativos-controller.spec.ts",
		"test:e2e": "dotenv -e .env.e2e -- vitest --dir __tests__",
		"test:e2e:watch": "dotenv -v TEST_TYPE=e2e -- vitest --ui --dir __tests__/e2e",
		"fix-ssl": "set NODE_TLS_REJECT_UNAUTHORIZED=0",
		"db:push": "npx drizzle-kit push",
		"db:generate": "npx drizzle-kit generate",
		"db:migrate": "npx drizzle-kit migrate"
	},
	"dependencies": {
		"bcrypt": "^6.0.0",
		"cors": "^2.8.6",
		"csv-parse": "^6.2.1",
		"date-fns": "^4.1.0",
		"dotenv": "^17.3.1",
		"drizzle-orm": "^0.45.1",
		"drizzle-seed": "^0.3.1",
		"express": "^5.2.1",
		"helmet": "^8.1.0",
		"jsonwebtoken": "^9.0.3",
		"ms": "^2.1.3",
		"multer": "^2.1.1",
		"mysql2": "^3.20.0",
		"rate-limiter-flexible": "^10.0.1",
		"uuidv7": "^1.1.0",
		"xlsx": "^0.18.5",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@faker-js/faker": "^10.3.0",
		"@types/bcrypt": "^6.0.0",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/multer": "^2.1.0",
		"@types/node": "^25.9.1",
		"@types/supertest": "^7.2.0",
		"@vitest/coverage-v8": "^4.1.0",
		"@vitest/ui": "^4.1.0",
		"dotenv-cli": "^11.0.0",
		"drizzle-kit": "^0.31.10",
		"nodemon": "^3.1.14",
		"supertest": "^7.2.2",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"tsup": "^8.5.1",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"vitest": "^4.1.0"
	}
}
